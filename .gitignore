# .gitignore for Python + Node monorepo

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log
.pnpm-store/

# Vite / frontend build
dist/
build/
public/build/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Local environment variables
.env
.env.*.local

# Database files
*.sqlite3
db.sqlite3

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml
.env.docker

# Misc
*.swp
*~
